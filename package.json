{
  "name": "portfolio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.mjs",
    "dev:hugo": "hugo server --disableFastRender",
    "build": "hugo --gc --minify",
    "check": "hugo --gc --minify --printPathWarnings --printI18nWarnings",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vercel/node": "^3.2.0",
    "resend": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "hugo-extended": "latest",
    "postcss": "^8",
    "postcss-cli": "latest",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
